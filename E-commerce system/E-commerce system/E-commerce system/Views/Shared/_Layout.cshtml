<!DOCTYPE html>
<html lang="en">
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RN store</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="top-header">
        <nav class="navbar">
            <div class="nav-container">
                <a class="nav-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-store" style="color:var(--text-primary);"></i> RN store
                </a>
                
                <form class="search-bar" asp-controller="Product" asp-action="Index" method="get">
                    <select style="border:none; background:none; outline:none; font-size:0.85rem; padding-right:0.5rem; border-right:1px solid var(--border-color); color:var(--text-secondary);">
                        <option>All Category</option>
                    </select>
                    <i class="fa-solid fa-magnifying-glass" style="color:var(--text-secondary); margin-left:1rem;"></i>
                    <input type="text" placeholder="Find whatever you need" />
                </form>

                <ul class="nav-links">
                    
                    @if (string.IsNullOrEmpty(HttpContextAccessor.HttpContext?.Session.GetString("UserName")))
                    {
                        <li><a asp-area="" asp-controller="Account" asp-action="Register" class="btn-secondary-small">Sign Up</a></li>
                        <li><a asp-area="" asp-controller="Account" asp-action="Login" class="btn-primary-small" style="background: black; color: white;">Login</a></li>
                    }
                    else
                    {
                        <li class="profile-dropdown" style="position: relative; display: inline-block;">
                            <a href="#" style="font-weight: 600; color: var(--text-primary); padding-bottom: 1rem;">
                                <i class="fa-regular fa-circle-user"></i> @HttpContextAccessor.HttpContext.Session.GetString("UserName")
                            </a>
                            <div class="dropdown-content" style="display: none; position: absolute; right: 0; top: 100%; background-color: var(--bg-white); min-width: 160px; box-shadow: var(--shadow-md); z-index: 10; border-radius: var(--radius-sm); border: 1px solid var(--border-color); overflow:hidden;">
                                @if (HttpContextAccessor.HttpContext.Session.GetString("UserRole") == "Admin")
                                {
                                    <a asp-controller="Admin" asp-action="Index" style="color: var(--text-primary); padding: 12px 16px; text-decoration: none; display: block; width: 100%; box-sizing: border-box; text-align: left;">Admin Dashboard</a>
                                }
                                else
                                {
                                    <a asp-controller="Account" asp-action="Profile" style="color: var(--text-primary); padding: 12px 16px; text-decoration: none; display: block; width: 100%; box-sizing: border-box; text-align: left;">My Profile</a>
                                }
                                <a asp-controller="Account" asp-action="Logout" style="color: var(--accent-red); padding: 12px 16px; text-decoration: none; display: block; border-top: 1px solid var(--border-color); width: 100%; box-sizing: border-box; text-align: left;">Logout</a>
                            </div>
                        </li>
                    }

                    @if(HttpContextAccessor.HttpContext?.Session.GetString("UserRole") != "Admin")
                    {
                        <li><a asp-area="" asp-controller="Wishlist" asp-action="Index" style="font-size: 1.2rem;"><i class="fa-regular fa-heart"></i></a></li>
                        <li>
                            <a asp-area="" asp-controller="Cart" asp-action="Index" style="font-size: 1.2rem; position: relative; display: flex; align-items: center;">
                                <i class="fa-solid fa-cart-shopping"></i>
                                @{
                                    var cartJson = HttpContextAccessor.HttpContext?.Session.GetString("CartItems");
                                    var cartCount = 0;
                                    if (cartJson != null)
                                    {
                                        var cart = System.Text.Json.JsonSerializer.Deserialize<List<E_commerce_system.Models.CartItem>>(cartJson);
                                        cartCount = cart?.Sum(x => x.Quantity) ?? 0;
                                    }
                                }
                                @if (cartCount > 0)
                                {
                                    <span style="position: absolute; top: -8px; right: -8px; background: #ef4444; color: white; font-size: 0.7rem; font-weight: bold; width: 18px; height: 18px; border-radius: 50%; display: flex; justify-content: center; align-items: center; border: 2px solid white;">@cartCount</span>
                                }
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    </header>
    
    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="dark-footer">
        <div class="footer-container">
            <div class="footer-brand">
                <h2><i class="fa-solid fa-store"></i> RN store</h2>
                <p style="color:var(--footer-text); font-style: italic;">"Let's Shop Beyond Boundaries"</p>
                <div style="display:flex; gap:1rem; margin-top:2rem;">
                    <i class="fa-brands fa-facebook"></i>
                    <i class="fa-brands fa-twitter"></i>
                    <i class="fa-brands fa-instagram"></i>
                    <i class="fa-brands fa-youtube"></i>
                </div>
            </div>
            <div class="footer-col">
                <h4>RN store</h4>
                <div class="footer-links">
                    <a href="#">About RN store</a>
                    <a href="#">Career</a>
                    <a href="#">RN store Blog</a>
                    <a href="#">RN store Digital</a>
                </div>
            </div>
            <div class="footer-col">
                <h4>Buy</h4>
                <div class="footer-links">
                    <a href="#">RN store Pay</a>
                    <a href="#">RN store COD</a>
                    <a href="#">RN store Card</a>
                  
                </div>
            </div>
            <div class="footer-col">
                <h4>Sell</h4>
                <div class="footer-links">
                    <a href="#">Seller Education Center</a>
                    <a href="#">Brands Home</a>
                    <a href="#">Register Official Store</a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            &copy; 2026 - 2029, RN store
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
