@model IEnumerable<E_commerce_system.Models.User>
@{
    ViewData["Title"] = "Manage Users";
}

<div style="display: grid; grid-template-columns: 250px 1fr; gap: 2rem; min-height: 80vh;">
    <partial name="_AdminSidebar" />
    
    <div class="dashboard-content" style="padding: 1rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
            <h2 style="margin: 0;">Users</h2>
        </div>
        
        <div style="background: var(--glass-bg); border-radius: 16px; border: 1px solid var(--glass-border); overflow: hidden;">
            <table style="width: 100%; border-collapse: collapse; text-align: left;">
                <thead style="background: rgba(0,0,0,0.3);">
                    <tr>
                        <th style="padding: 1rem;">ID</th>
                        <th style="padding: 1rem;">Username</th>
                        <th style="padding: 1rem;">Email</th>
                        <th style="padding: 1rem;">Role</th>
                        <th style="padding: 1rem;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var item in Model ?? new List<E_commerce_system.Models.User>())
                    {
                        <tr style="border-top: 1px solid var(--glass-border);">
                            <td style="padding: 1rem;">@item.Id</td>
                            <td style="padding: 1rem;">@item.Name</td>
                            <td style="padding: 1rem;">@item.Email</td>
                            <td style="padding: 1rem;">
                                <span style="background: @(item.Role == "Admin" ? "rgba(239, 68, 68, 0.2)" : "rgba(139, 92, 246, 0.2)"); color: @(item.Role == "Admin" ? "#fca5a5" : "#c4b5fd"); padding: 0.2rem 0.6rem; border-radius: 12px; font-size: 0.85rem;">@item.Role</span>
                            </td>
                            <td style="padding: 1rem;">
                                <a href="#" style="color: #ef4444;" title="Delete User"><i class="fa-solid fa-trash"></i></a>
                            </td>
                        </tr>
                    }
                    @if(!Model?.Any() ?? true)
                    {
                        <tr><td colspan="5" style="padding: 2rem; text-align: center; color: var(--text-secondary);">No users registered.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
