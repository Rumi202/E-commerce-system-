@model IEnumerable<E_commerce_system.Models.Category>
@{
    ViewData["Title"] = "Manage Categories";
}

<div style="display: grid; grid-template-columns: 250px 1fr; gap: 2rem; min-height: 80vh;">
    <partial name="_AdminSidebar" />
    
    <div class="dashboard-content" style="padding: 1rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
            <h2 style="margin: 0;">Categories</h2>
            <a asp-action="CategoryCreate" class="btn-primary-small" style="background: var(--accent-green); text-decoration: none;">+ Add New Category</a>
        </div>
        
        <div style="background: var(--glass-bg); border-radius: 16px; border: 1px solid var(--glass-border); overflow: hidden;">
            <table style="width: 100%; border-collapse: collapse; text-align: left;">
                <thead style="background: rgba(0,0,0,0.3);">
                    <tr>
                        <th style="padding: 1rem;">ID</th>
                        <th style="padding: 1rem;">Category Name</th>
                        <th style="padding: 1rem;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var item in Model ?? new List<E_commerce_system.Models.Category>())
                    {
                        <tr style="border-top: 1px solid var(--glass-border);">
                            <td style="padding: 1rem;">@item.Id</td>
                            <td style="padding: 1rem;">@item.Name</td>
                            <td style="padding: 1rem; display: flex; gap: 1rem;">
                                <a asp-action="CategoryEdit" asp-route-id="@item.Id" style="color: var(--accent-dark);"><i class="fa-solid fa-pen"></i></a>
                                <form asp-action="CategoryDelete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this category?');">
                                    <button type="submit" style="background:none; border:none; padding:0; color: var(--accent-red); cursor:pointer;"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if(!Model?.Any() ?? true)
                    {
                        <tr><td colspan="3" style="padding: 2rem; text-align: center; color: var(--text-secondary);">No categories available.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
