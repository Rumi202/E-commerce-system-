@using Microsoft.AspNetCore.Http
<div class="sidebar" style="background: var(--glass-bg); border-right: 1px solid var(--glass-border); padding: 2rem 1rem; border-radius: 16px;">
    <h3 style="margin-bottom: 2rem; font-weight: 700;">Admin Panel</h3>
    <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 1rem;">
        <li>
            <a asp-controller="Admin" asp-action="Index" style="color: @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "var(--accent)" : "var(--text-secondary)"); text-decoration: none; font-weight: @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "600" : "400");">
                <i class="fa-solid fa-gauge"></i> Dashboard
            </a>
        </li>
        <li>
            <a asp-controller="Admin" asp-action="Products" style="color: @(ViewContext.RouteData.Values["action"]?.ToString() == "Products" ? "var(--accent)" : "var(--text-secondary)"); text-decoration: none; font-weight: @(ViewContext.RouteData.Values["action"]?.ToString() == "Products" ? "600" : "400");">
                <i class="fa-solid fa-box"></i> Products
            </a>
        </li>
        <li>
            <a asp-controller="Admin" asp-action="Categories" style="color: @(ViewContext.RouteData.Values["action"]?.ToString() == "Categories" ? "var(--accent)" : "var(--text-secondary)"); text-decoration: none; font-weight: @(ViewContext.RouteData.Values["action"]?.ToString() == "Categories" ? "600" : "400");">
                <i class="fa-solid fa-tags"></i> Categories
            </a>
        </li>
        <li>
            <a asp-controller="Admin" asp-action="Orders" style="color: @(ViewContext.RouteData.Values["action"]?.ToString() == "Orders" ? "var(--accent)" : "var(--text-secondary)"); text-decoration: none; font-weight: @(ViewContext.RouteData.Values["action"]?.ToString() == "Orders" ? "600" : "400");">
                <i class="fa-solid fa-cart-arrow-down"></i> Orders
            </a>
        </li>
        <li>
            <a asp-controller="Admin" asp-action="Users" style="color: @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "var(--accent)" : "var(--text-secondary)"); text-decoration: none; font-weight: @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "600" : "400");">
                <i class="fa-solid fa-users"></i> Users
            </a>
        </li>
        <li>
            <a asp-controller="Admin" asp-action="Support" style="color: @(ViewContext.RouteData.Values["action"]?.ToString() == "Support" || ViewContext.RouteData.Values["action"]?.ToString() == "SupportChat" ? "var(--accent)" : "var(--text-secondary)"); text-decoration: none; font-weight: @(ViewContext.RouteData.Values["action"]?.ToString() == "Support" ? "600" : "400");">
                <i class="fa-solid fa-ticket"></i> Support
            </a>
        </li>
        <li>
            <a asp-controller="Admin" asp-action="FlashSales" style="color: @(ViewContext.RouteData.Values["action"]?.ToString() == "FlashSales" ? "var(--accent)" : "var(--text-secondary)"); text-decoration: none; font-weight: @(ViewContext.RouteData.Values["action"]?.ToString() == "FlashSales" ? "600" : "400");">
                <i class="fa-solid fa-bolt"></i> Flash Sales
            </a>
        </li>
        <li>
            <a asp-controller="Admin" asp-action="Banners" style="color: @(ViewContext.RouteData.Values["action"]?.ToString() == "Banners" ? "var(--accent)" : "var(--text-secondary)"); text-decoration: none; font-weight: @(ViewContext.RouteData.Values["action"]?.ToString() == "Banners" ? "600" : "400");">
                <i class="fa-solid fa-image"></i> Banners
            </a>
        </li>
        <li style="margin-top: 2rem; border-top: 1px solid var(--glass-border); padding-top: 1rem;">
            <a asp-controller="Account" asp-action="Logout" style="color: var(--accent-red); text-decoration: none; font-weight: 600;">
                <i class="fa-solid fa-right-from-bracket"></i> Logout
            </a>
        </li>
    </ul>
</div>
