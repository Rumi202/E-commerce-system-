@model IEnumerable<E_commerce_system.Models.Product>
@{
    ViewData["Title"] = "Manage Products";
}

<div style="display: grid; grid-template-columns: 250px 1fr; gap: 2rem; min-height: 80vh;">
    <partial name="_AdminSidebar" />
    
    <div class="dashboard-content" style="padding: 1rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
            <h2 style="margin: 0;">Products</h2>
            <a asp-action="ProductCreate" class="btn-primary-small" style="background: var(--accent-green);">+ Add New Product</a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div style="background: rgba(34, 197, 94, 0.1); color: #22c55e; padding: 1rem; border-radius: 8px; border: 1px solid rgba(34, 197, 94, 0.2); margin-bottom: 1.5rem;">
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div style="background: rgba(239, 68, 68, 0.1); color: #ef4444; padding: 1rem; border-radius: 8px; border: 1px solid rgba(239, 68, 68, 0.2); margin-bottom: 1.5rem;">
                @TempData["Error"]
            </div>
        }
        
        <div style="background: var(--glass-bg); border-radius: 16px; border: 1px solid var(--glass-border); overflow: hidden;">
            <table style="width: 100%; border-collapse: collapse; text-align: left;">
                <thead style="background: rgba(0,0,0,0.3);">
                    <tr>
                        <th style="padding: 1rem;">ID</th>
                        <th style="padding: 1rem;">Name</th>
                        <th style="padding: 1rem;">Category</th>
                        <th style="padding: 1rem;">Price</th>
                        <th style="padding: 1rem;">Stock</th>
                        <th style="padding: 1rem;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var item in Model ?? new List<E_commerce_system.Models.Product>())
                    {
                        <tr style="border-top: 1px solid var(--glass-border);">
                            <td style="padding: 1rem;">@item.Id</td>
                            <td style="padding: 1rem;">@item.Name</td>
                            <td style="padding: 1rem; color: var(--text-secondary);">@(item.Category?.Name ?? "No Category")</td>
                            <td style="padding: 1rem;">৳@item.Price</td>
                            <td style="padding: 1rem;">@item.StockQuantity</td>
                            <td style="padding: 1rem; display: flex; gap: 1rem;">
                                <a asp-action="ProductEdit" asp-route-id="@item.Id" style="color: var(--accent-dark);"><i class="fa-solid fa-pen"></i></a>
                                <form asp-action="ProductDelete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                    <button type="submit" style="background:none; border:none; padding:0; color: var(--accent-red); cursor:pointer;"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if(!Model?.Any() ?? true)
                    {
                        <tr><td colspan="5" style="padding: 2rem; text-align: center; color: var(--text-secondary);">No products available.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
