@model E_commerce_system.Models.Product
@{
    ViewData["Title"] = "Create Product";
}
<div style="display: grid; grid-template-columns: 250px 1fr; gap: 2rem; min-height: 80vh;">
    <div class="sidebar" style="background: var(--bg-white); border-right: 1px solid var(--border-color); padding: 2rem 1rem; border-radius: var(--radius-lg);">
        <h3 style="margin-bottom: 2rem; font-weight: 700;">Admin Panel</h3>
        <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 1rem;">
            <li><a asp-action="Index" style="color: var(--text-secondary); text-decoration: none;"><i class="fa-solid fa-gauge"></i> Dashboard</a></li>
            <li><a asp-action="Products" style="color: var(--accent-red); text-decoration: none; font-weight: 600;"><i class="fa-solid fa-box"></i> Products</a></li>
            <li><a asp-action="Categories" style="color: var(--text-secondary); text-decoration: none;"><i class="fa-solid fa-tags"></i> Categories</a></li>
            <li><a asp-action="Orders" style="color: var(--text-secondary); text-decoration: none;"><i class="fa-solid fa-cart-arrow-down"></i> Orders</a></li>
        </ul>
    </div>

    <div class="dashboard-content" style="padding: 1rem;">
        <h2 style="margin-bottom: 2rem;">Create Product</h2>
        
        <form asp-action="ProductCreate" method="post" enctype="multipart/form-data" style="background: var(--bg-white); padding: 2rem; border-radius: var(--radius-lg); border: 1px solid var(--border-color); max-width: 600px;">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Name</label>
                <input asp-for="Name" class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: var(--radius-sm); box-sizing: border-box;" required />
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: var(--radius-sm); box-sizing: border-box;" required></textarea>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                <div>
                    <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Price (৳)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: var(--radius-sm); box-sizing: border-box;" required />
                </div>
                <div>
                    <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Stock</label>
                    <input asp-for="StockQuantity" type="number" class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: var(--radius-sm); box-sizing: border-box;" required />
                </div>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Product Image</label>
                <input type="file" name="imageFile" accept="image/*" class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: var(--radius-sm); box-sizing: border-box;" />
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Category</label>
                <select asp-for="CategoryId" class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: var(--radius-sm); box-sizing: border-box;">
                    <option value="">-- Select Category --</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in (List<E_commerce_system.Models.Category>)ViewBag.Categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    }
                </select>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Gender</label>
                <select asp-for="Gender" class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: var(--radius-sm); box-sizing: border-box;">
                    <option value="">Any / Unisex</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <button type="submit" class="btn-primary-small" style="padding: 0.75rem 2rem; border: none; cursor: pointer;">Save Product</button>
            <a asp-action="Products" style="margin-left: 1rem; color: var(--text-secondary); text-decoration: none;">Cancel</a>
        </form>
    </div>
</div>
