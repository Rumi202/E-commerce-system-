@model E_commerce_system.Models.DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div style="display: grid; grid-template-columns: 250px 1fr; gap: 2rem; min-height: 80vh;">
    <partial name="_AdminSidebar" />
    
    <div class="dashboard-content" style="padding: 1rem;">
        <h2 style="margin-bottom: 2rem;">Dashboard Overview</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; margin-bottom: 3rem;">
            <div style="background: linear-gradient(135deg, rgba(30,41,59,0.9), rgba(15,23,42,0.9)); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--glass-border);">
                <p style="color: var(--text-secondary); margin: 0; font-size: 0.9rem;">Total Revenue</p>
                <h3 style="margin: 0.5rem 0 0 0; color: #10b981; font-size: 2rem;">৳@Model.TotalRevenue.ToString("N0")</h3>
            </div>
            <div style="background: linear-gradient(135deg, rgba(30,41,59,0.9), rgba(15,23,42,0.9)); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--glass-border);">
                <p style="color: var(--text-secondary); margin: 0; font-size: 0.9rem;">Active Orders</p>
                <h3 style="margin: 0.5rem 0 0 0; color: #3b82f6; font-size: 2rem;">@Model.ActiveOrdersCount</h3>
            </div>
            <div style="background: linear-gradient(135deg, rgba(30,41,59,0.9), rgba(15,23,42,0.9)); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--glass-border);">
                <p style="color: var(--text-secondary); margin: 0; font-size: 0.9rem;">Open Tickets</p>
                <h3 style="margin: 0.5rem 0 0 0; color: #f59e0b; font-size: 2rem;">@Model.OpenTicketsCount</h3>
            </div>
            <div style="background: linear-gradient(135deg, rgba(30,41,59,0.9), rgba(15,23,42,0.9)); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--glass-border);">
                <p style="color: var(--text-secondary); margin: 0; font-size: 0.9rem;">Total Products</p>
                <h3 style="margin: 0.5rem 0 0 0; color: #8b5cf6; font-size: 2rem;">@Model.TotalProductsCount</h3>
            </div>
            <div style="background: linear-gradient(135deg, rgba(30,41,59,0.9), rgba(15,23,42,0.9)); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--glass-border);">
                <p style="color: var(--text-secondary); margin: 0; font-size: 0.9rem;">Total Customers</p>
                <h3 style="margin: 0.5rem 0 0 0; color: #ec4899; font-size: 2rem;">@Model.TotalUsersCount</h3>
            </div>
        </div>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
            <div style="background: var(--glass-bg); padding: 1.5rem; border-radius: 16px; border: 1px solid var(--glass-border);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                    <h3 style="margin: 0;">Recent Tickets</h3>
                    <a asp-action="Support" style="color: var(--accent); text-decoration: none; font-size: 0.85rem;">View All</a>
                </div>
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    @foreach(var ticket in Model.RecentTickets)
                    {
                        <div style="padding: 1rem; background: rgba(0,0,0,0.2); border-radius: 8px; border-left: 4px solid @(ticket.Status == "Open" ? "#f59e0b" : "#10b981");">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                <div>
                                    <div style="font-weight: 600; font-size: 0.95rem;">@ticket.Subject</div>
                                    <div style="font-size: 0.75rem; color: var(--text-secondary);">@ticket.User?.Name · @ticket.CreatedAt.ToShortDateString()</div>
                                </div>
                                <span style="font-size: 0.7rem; padding: 0.2rem 0.5rem; border-radius: 4px; background: rgba(245, 158, 11, 0.1); color: #fbbf24;">@ticket.Status</span>
                            </div>
                            <a asp-action="SupportChat" asp-route-id="@ticket.Id" style="display: inline-block; margin-top: 0.5rem; font-size: 0.8rem; color: var(--accent); text-decoration: none;">Reply →</a>
                        </div>
                    }
                    @if(!Model.RecentTickets.Any())
                    {
                        <p style="text-align: center; color: var(--text-secondary); padding: 1rem;">No recent tickets.</p>
                    }
                </div>
            </div>

            <div style="background: var(--glass-bg); padding: 1.5rem; border-radius: 16px; border: 1px solid var(--glass-border);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                    <h3 style="margin: 0;">Recent Orders</h3>
                    <a asp-action="Orders" style="color: var(--accent); text-decoration: none; font-size: 0.85rem;">View All</a>
                </div>
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    @foreach(var order in Model.RecentOrders)
                    {
                        <div style="padding: 1rem; background: rgba(0,0,0,0.2); border-radius: 8px; display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <div style="font-weight: 600; font-size: 0.95rem;">#@order.Id · @order.User?.Name</div>
                                <div style="font-size: 0.75rem; color: var(--text-secondary);">@order.OrderDate.ToShortDateString() · @order.Status</div>
                            </div>
                            <div style="font-weight: 700; color: var(--text-primary);">৳@order.TotalAmount.ToString("N0")</div>
                        </div>
                    }
                    @if(!Model.RecentOrders.Any())
                    {
                        <p style="text-align: center; color: var(--text-secondary); padding: 1rem;">No recent orders.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
