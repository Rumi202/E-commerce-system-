@model E_commerce_system.Models.SupportTicket
@{
    ViewData["Title"] = "Admin Support Chat";
}

<div style="display: grid; grid-template-columns: 250px 1fr; gap: 2rem; min-height: 80vh;">
    <div class="sidebar" style="background: var(--glass-bg); border-right: 1px solid var(--glass-border); padding: 2rem 1rem; border-radius: 16px;">
        <h3 style="margin-bottom: 2rem; font-weight: 700;">Admin Panel</h3>
        <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 1rem;">
            <li><a asp-action="Index" style="color: var(--text-secondary); text-decoration: none;"><i class="fa-solid fa-gauge"></i> Dashboard</a></li>
            <li><a asp-action="Support" style="color: var(--accent); text-decoration: none; font-weight: 600;"><i class="fa-solid fa-arrow-left"></i> Back to Tickets</a></li>
        </ul>
    </div>
    
    <div class="chat-container flex-column" style="background: var(--glass-bg); padding: 2rem; border-radius: 16px; border: 1px solid var(--glass-border); display: flex; flex-direction: column;">
        <div class="chat-header" style="border-bottom: 1px solid var(--glass-border); padding-bottom: 1rem; margin-bottom: 1rem;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <h2 style="margin: 0; color: var(--text-primary);">Ticket #@(Model?.Id ?? 0)</h2>
            </div>
            <p style="color: var(--text-secondary); margin: 0.5rem 0 0 0;"><strong>Subject:</strong> @(Model?.Subject ?? "Unknown")</p>
        </div>
        
        <div class="messages" id="messagesList" style="flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 1rem; padding: 1rem; background: rgba(0,0,0,0.2); border-radius: 12px; margin-bottom: 1rem; min-height: 400px;">
            <!-- Initial User Description -->
            <div style="align-self: flex-start; background: #1e293b; padding: 1rem; border-radius: 12px 12px 12px 0; max-width: 70%; border: 1px solid var(--glass-border);">
                <p style="margin: 0; font-size: 0.95rem; color: #94a3b8; font-weight: 600; margin-bottom: 0.3rem;">User (Initial Ticket)</p>
                <p style="margin: 0; font-size: 0.95rem; color: white;">
                    <strong>Category:</strong> @Model.Category<br/>
                    @Model.Description
                </p>
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div style="margin-top: 1rem;">
                        <img src="@Model.ImageUrl" alt="Ticket Image" style="max-width: 100%; border-radius: 8px; border: 1px solid var(--glass-border);" />
                    </div>
                }
                <small style="color: var(--text-secondary); font-size: 0.75rem;">@Model.CreatedAt.ToString("MMM dd, HH:mm")</small>
            </div>

            @if (Model.Messages != null)
            {
                foreach (var msg in Model.Messages.OrderBy(m => m.Timestamp))
                {
                    bool isAdmin = msg.IsAdminReply;
                    <div style="align-self: @(isAdmin ? "flex-end" : "flex-start"); background: rgba(0,0,0,0.05); padding: 1rem; border-radius: @(isAdmin ? "12px 12px 0 12px" : "12px 12px 12px 0"); max-width: 70%; border: 1px solid var(--glass-border);">
                        <p style="margin: 0; font-size: 0.95rem; color: #000000; font-weight: 600; margin-bottom: 0.3rem;">@(isAdmin ? "You (Admin)" : "User")</p>
                        <p style="margin: 0; font-size: 0.95rem; color: #000000;">@msg.Message</p>
                        <small style="color: var(--text-secondary); font-size: 0.75rem;">@msg.Timestamp.ToLocalTime().ToString("hh:mm tt")</small>
                    </div>
                }
            }
        </div>

        <form asp-action="ReplyToTicket" method="post" style="display: flex; gap: 1rem;">
            <input type="hidden" name="ticketId" value="@Model.Id" />
            <input type="text" name="message" class="form-control" placeholder="Type your reply here..." style="flex: 1; padding: 1rem; border-radius: 8px; border: 1px solid var(--glass-border); background: rgba(0,0,0,0.3); color: white;" required autocomplete="off" />
            <button type="submit" class="btn-primary" style="padding: 0 1.5rem; border-radius: 8px; border: none; background: #000000; color: white; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; transition: background 0.2s;">
                <span>Send Reply</span> <i class="fa-solid fa-paper-plane"></i>
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Scroll to bottom
        const list = document.getElementById("messagesList");
        list.scrollTop = list.scrollHeight;
    </script>
}
