@model E_commerce_system.Models.ProductListViewModel
@{
    ViewData["Title"] = Model.SelectedCategoryName ?? "All Products";
}

<div class="page-wrapper" style="margin-top: 2rem;">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem;">
        <div>
            <h1 style="font-size: 2.5rem; margin: 0; color: var(--text-primary);">
                @(Model.SelectedCategoryName ?? "Shop All")
            </h1>
            <p style="color: var(--text-secondary); margin: 0.5rem 0 0 0;">
                @if (!string.IsNullOrEmpty(Model.SelectedGender))
                {
                    <span>Filter: @Model.SelectedGender</span>
                }
            </p>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 250px 1fr; gap: 3rem;">
        <!-- Filters Sidebar -->
        <aside>
            <div style="margin-bottom: 2rem;">
                <h3 style="font-size: 1.1rem; margin-bottom: 1rem; border-bottom: 2px solid var(--text-primary); display: inline-block; padding-bottom: 0.5rem;">Categories</h3>
                <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem;">
                    <li>
                        <a asp-action="Index" asp-route-gender="@Model.SelectedGender" 
                           style="text-decoration: none; color: @(Model.SelectedCategoryId == null ? "var(--text-primary)" : "var(--text-secondary)"); font-weight: @(Model.SelectedCategoryId == null ? "700" : "500"); display: block; padding: 0.5rem; border-radius: var(--radius-sm); background: @(Model.SelectedCategoryId == null ? "#f1f5f9" : "transparent");">
                            All Categories
                        </a>
                    </li>
                    @foreach (var cat in Model.Categories)
                    {
                        <li>
                            <a asp-action="Index" asp-route-categoryId="@cat.Id" asp-route-gender="@Model.SelectedGender" 
                               style="text-decoration: none; color: @(Model.SelectedCategoryId == cat.Id ? "var(--text-primary)" : "var(--text-secondary)"); font-weight: @(Model.SelectedCategoryId == cat.Id ? "700" : "500"); display: block; padding: 0.5rem; border-radius: var(--radius-sm); background: @(Model.SelectedCategoryId == cat.Id ? "#f1f5f9" : "transparent");">
                                @cat.Name
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <div style="margin-bottom: 2rem;">
                <h3 style="font-size: 1.1rem; margin-bottom: 1rem; border-bottom: 2px solid var(--text-primary); display: inline-block; padding-bottom: 0.5rem;">Gender</h3>
                <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem;">
                    <li>
                        <a asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-gender="" 
                           style="text-decoration: none; color: @(string.IsNullOrEmpty(Model.SelectedGender) ? "var(--text-primary)" : "var(--text-secondary)"); font-weight: @(string.IsNullOrEmpty(Model.SelectedGender) ? "700" : "500"); display: block; padding: 0.5rem; border-radius: var(--radius-sm); background: @(string.IsNullOrEmpty(Model.SelectedGender) ? "#f1f5f9" : "transparent");">
                            All Genders
                        </a>
                    </li>
                    <li>
                        <a asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-gender="Male" 
                           style="text-decoration: none; color: @(Model.SelectedGender == "Male" ? "var(--text-primary)" : "var(--text-secondary)"); font-weight: @(Model.SelectedGender == "Male" ? "700" : "500"); display: block; padding: 0.5rem; border-radius: var(--radius-sm); background: @(Model.SelectedGender == "Male" ? "#f1f5f9" : "transparent");">
                            Men
                        </a>
                    </li>
                    <li>
                        <a asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-gender="Female" 
                           style="text-decoration: none; color: @(Model.SelectedGender == "Female" ? "var(--text-primary)" : "var(--text-secondary)"); font-weight: @(Model.SelectedGender == "Female" ? "700" : "500"); display: block; padding: 0.5rem; border-radius: var(--radius-sm); background: @(Model.SelectedGender == "Female" ? "#f1f5f9" : "transparent");">
                            Women
                        </a>
                    </li>
                </ul>
            </div>
            
            @if (Model.SelectedCategoryId != null || !string.IsNullOrEmpty(Model.SelectedGender))
            {
                <a asp-action="Index" style="display: block; text-align: center; padding: 0.75rem; background: var(--bg-main); border: 1px solid var(--border-color); border-radius: var(--radius-sm); color: var(--accent-red); text-decoration: none; font-weight: 600;">
                    Clear All Filters
                </a>
            }
        </aside>

        <!-- Product Grid -->
        <div>
            @if (!Model.Products.Any())
            {
                <div style="text-align: center; padding: 4rem 2rem; background: #f8f9fa; border-radius: var(--radius-lg);">
                    <i class="fa-solid fa-box-open" style="font-size: 3rem; color: #ccc; margin-bottom: 1rem;"></i>
                    <h3 style="margin: 0 0 0.5rem 0; color: var(--text-primary);">No Products Found</h3>
                    <p style="color: var(--text-secondary); margin: 0;">Try adjusting your filters or browsing all categories.</p>
                </div>
            }
            else
            {
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 3rem;">
                    @foreach (var product in Model.Products)
                    {
                        <div class="product-card" style="padding: 1rem; position: relative;">
                            @if (product.IsFlashSale && product.DiscountPercentage > 0)
                            {
                                <div style="position: absolute; top: 1rem; left: 1rem; background: var(--accent-red); color: white; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: bold; z-index: 2;">
                                    -@product.DiscountPercentage%
                                </div>
                            }
                            <button onclick="addToWishlist(@product.Id)" style="position: absolute; top: 1rem; right: 1rem; background: black; border: 1px solid rgba(255,255,255,0.1); border-radius: 50%; width: 30px; height: 30px; display: flex; justify-content: center; align-items: center; box-shadow: var(--shadow-sm); z-index: 2; cursor:pointer;">
                                <i class="fa-regular fa-heart" style="color: white;"></i>
                            </button>
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" style="text-decoration: none; color: inherit;">
                                <div style="height: 200px; background: var(--bg-main); border-radius: var(--radius-sm); margin-bottom: 1rem; display: flex; justify-content: center; align-items: center; overflow: hidden;">
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" alt="@product.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-shirt" style="font-size: 3rem; color: #9ca3af;"></i>
                                    }
                                </div>
                                <h3 style="font-size: 1rem; font-weight: 600; margin: 0 0 0.5rem 0; color: var(--text-primary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@product.Name</h3>
                            </a>
                            
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <div>
                                    @if (product.IsFlashSale && product.DiscountPercentage > 0)
                                    {
                                        <div style="display: flex; align-items: baseline; gap: 0.5rem;">
                                            <span style="font-size: 1.1rem; font-weight: 700; color: var(--accent-red);">৳@(product.DiscountedPrice.ToString("N0"))</span>
                                            <span style="font-size: 0.85rem; color: var(--text-secondary); text-decoration: line-through;">৳@(product.Price.ToString("N0"))</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="font-size: 1.1rem; font-weight: 700; color: var(--text-primary);">
                                            ৳@(product.Price.ToString("N0"))
                                        </div>
                                    }
                                </div>
                                <div style="font-size: 0.75rem; color: @(product.StockQuantity > 0 ? "var(--text-secondary)" : "var(--accent-red)");">
                                    @(product.StockQuantity > 0 ? $"{product.StockQuantity} left" : "Sold out")
                                </div>
                            </div>
                            
                            <div style="margin-top: 1rem;">
                                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                    <input type="hidden" name="id" value="@product.Id" />
                                    @if (product.StockQuantity > 0)
                                    {
                                        <button type="submit" style="width: 100%; background: black; color: white; padding: 0.75rem 1rem; border-radius: 6px; font-size: 0.9rem; border: none; cursor: pointer; font-weight: 600;">Add to Cart</button>
                                    }
                                    else
                                    {
                                        <button type="button" disabled style="width: 100%; background: var(--text-secondary); color: white; padding: 0.75rem 1rem; border-radius: 6px; font-size: 0.9rem; border: none; cursor: not-allowed; opacity: 0.6; font-weight: 600;">Out of Stock</button>
                                    }
                                </form>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div style="display: flex; justify-content: center; align-items: center; gap: 0.5rem; margin-top: 2rem;">
                        <!-- Previous Button -->
                        @if (Model.CurrentPage > 1)
                        {
                            <a asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-gender="@Model.SelectedGender" asp-route-page="@(Model.CurrentPage - 1)"
                               style="width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--border-color); display: flex; justify-content: center; align-items: center; text-decoration: none; color: var(--text-primary);">
                                <i class="fa-solid fa-chevron-left"></i>
                            </a>
                        }

                        <!-- Page Numbers -->
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <a asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-gender="@Model.SelectedGender" asp-route-page="@i"
                               style="width: 40px; height: 40px; border-radius: 50%; display: flex; justify-content: center; align-items: center; text-decoration: none; font-weight: 600; 
                                      @(i == Model.CurrentPage ? "background: var(--text-primary); color: white;" : "background: transparent; color: var(--text-primary); border: 1px solid var(--border-color);")">
                                @i
                            </a>
                        }

                        <!-- Next Button -->
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-gender="@Model.SelectedGender" asp-route-page="@(Model.CurrentPage + 1)"
                               style="width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--border-color); display: flex; justify-content: center; align-items: center; text-decoration: none; color: var(--text-primary);">
                                <i class="fa-solid fa-chevron-right"></i>
                            </a>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>
