@model E_commerce_system.Models.Order

@{
    ViewData["Title"] = "Payment Selection";
}

<div class="checkout-container" style="max-width: 800px; margin: 0 auto; padding: 2rem 0;">
    <h2 style="margin-bottom: 2rem; color: black;">Select Payment Method</h2>

    <div style="background: var(--glass-bg); padding: 2.5rem; border-radius: 16px; border: 1px solid var(--glass-border); margin-bottom: 2rem;">
        <h3 style="margin-bottom: 1.5rem; color: black;">Order Summary</h3>
        <p style="color: black; margin-bottom: 0.5rem;">Order ID: <strong>#@Model.Id</strong></p>
        <p style="color: black; margin-bottom: 1.5rem;">Total Amount: <strong style="color: black; font-size: 1.2rem;">৳ @Model.TotalAmount.ToString("N2")</strong></p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
            <!-- Cash on Delivery -->
            <div style="background: rgba(0,0,0,0.3); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--glass-border); text-align: center;">
                <h4 style="color: white; margin-bottom: 1rem;">Cash on Delivery</h4>
                <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">Pay with cash upon delivery.</p>
                <form asp-action="PayWithCOD" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn-primary" style="width: 100%; padding: 0.75rem; border-radius: 8px; background: #333; color: white; border: none; font-weight: 600; cursor: pointer;">
                        Confirm Order (COD)
                    </button>
                </form>
            </div>

            <!-- SSLCommerz -->
            <div style="background: rgba(0,0,0,0.3); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--glass-border); text-align: center;">
                <h4 style="color: white; margin-bottom: 1rem;">Online Payment</h4>
                <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">Pay securely via SSLCommerz.</p>
                
                <button id="sslczPayBtn"
                        token="if you have any token validation"
                        postdata=""
                        order="If you already have the transaction generated for current order"
                        endpoint="/Order/InitSSLCommerz?orderId=@Model.Id"
                        class="btn-primary" 
                        style="width: 100%; padding: 0.75rem; border-radius: 8px; background: #0066cc; color: white; border: none; font-weight: 600; cursor: pointer;">
                    Pay with SSLCommerz
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function (window, document) {
            var loader = function () {
                var script = document.createElement("script"), tag = document.getElementsByTagName("script")[0];
                script.src = "https://sandbox.sslcommerz.com/embed.min.js?" + Math.random().toString(36).substring(7);
                tag.parentNode.insertBefore(script, tag);
            };

            window.addEventListener ? window.addEventListener("load", loader, false) : window.attachEvent("onload", loader);
        })(window, document);
    </script>
}
