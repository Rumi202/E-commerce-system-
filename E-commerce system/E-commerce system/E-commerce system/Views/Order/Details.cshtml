@model E_commerce_system.Models.Order
@{
    ViewData["Title"] = "Order Details";
}

<div class="order-details-container" style="max-width: 900px; margin: 4rem auto; padding: 0 1rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <a asp-action="History" style="color: var(--text-secondary); text-decoration: none; display: flex; align-items: center; gap: 0.5rem; font-weight: 500;">
            <i class="fa-solid fa-arrow-left"></i> Back to Orders
        </a>
        <a asp-controller="Account" asp-action="Profile" style="color: var(--text-secondary); text-decoration: none; display: flex; align-items: center; gap: 0.5rem; font-weight: 500;">
            Back to Profile <i class="fa-solid fa-user"></i>
        </a>
    </div>
    
    <div class="glass-card" style="background: var(--bg-white); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 3rem; box-shadow: var(--shadow-md);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #f1f5f9; padding-bottom: 2rem; margin-bottom: 2.5rem;">
            <div>
                <h2 style="margin: 0 0 0.5rem 0; font-size: 2rem; font-weight: 800;">Order #@Model.Id</h2>
                <p style="color: var(--text-secondary); margin: 0; font-size: 1rem;">Placed on @Model.OrderDate.ToString("MMMM dd, yyyy")</p>
            </div>
            <div style="text-align: right;">
                <span style="background: @(Model.Status == "Delivered" ? "#dcfce7" : "#fef3c7"); color: @(Model.Status == "Delivered" ? "#166534" : "#92400e"); padding: 0.5rem 1.25rem; border-radius: 8px; font-weight: 700; font-size: 0.9rem; letter-spacing: 0.025em; text-transform: uppercase;">
                    @Model.Status
                </span>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 3rem;">
            <div>
                <h3 style="margin: 0 0 1.5rem 0; font-size: 1.25rem; font-weight: 700;">Order Items</h3>
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    @foreach (var item in Model.OrderItems)
                    {
                        <div style="display: flex; justify-content: space-between; align-items: center; background: #f8fafc; padding: 1.25rem; border-radius: 12px; border: 1px solid #edf2f7;">
                            <div style="display: flex; align-items: center; gap: 1.25rem;">
                                <div style="width: 60px; height: 60px; background: white; border-radius: 8px; display: flex; justify-content: center; align-items: center; border: 1px solid #e2e8f0;">
                                    @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                    {
                                        <img src="@item.Product.ImageUrl" alt="@item.Product.Name" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-cube" style="color: #cbd5e1; font-size: 1.5rem;"></i>
                                    }
                                </div>
                                <div>
                                    <p style="margin: 0; font-weight: 600; color: var(--text-primary);">@item.Product.Name</p>
                                    <p style="margin: 0.25rem 0 0 0; color: var(--text-secondary); font-size: 0.85rem;">৳@item.UnitPrice × @item.Quantity</p>
                                </div>
                            </div>
                            <p style="margin: 0; font-weight: 700; color: var(--text-primary);">৳@(item.UnitPrice * item.Quantity)</p>
                        </div>
                    }
                </div>
            </div>

            <div>
                <div style="background: #f8fafc; padding: 2rem; border-radius: 16px; border: 1px solid #edf2f7;">
                    <h3 style="margin: 0 0 1.5rem 0; font-size: 1.1rem; font-weight: 700;">Order Summary</h3>
                    
                    <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem;">
                        <div style="display: flex; justify-content: space-between;">
                            <span style="color: var(--text-secondary);">Subtotal</span>
                            <span style="font-weight: 600;">৳@Model.TotalAmount</span>
                        </div>
                        <div style="display: flex; justify-content: space-between;">
                            <span style="color: var(--text-secondary);">Shipping</span>
                            <span style="font-weight: 600; color: #10b981;">Free</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; border-top: 2px dashed #e2e8f0; padding-top: 1rem; margin-top: 0.5rem;">
                            <span style="font-weight: 700; font-size: 1.1rem;">Total Amount</span>
                            <span style="font-weight: 800; font-size: 1.25rem; color: var(--text-primary);">৳@Model.TotalAmount</span>
                        </div>
                    </div>

                    <div style="margin-top: 2rem;">
                        <h4 style="margin: 0 0 0.75rem 0; font-size: 0.9rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em;">Shipping Details</h4>
                        <p style="margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--text-primary);">
                            @Model.ShippingAddress
                        </p>
                    </div>

                    <div style="margin-top: 1.5rem;">
                        <h4 style="margin: 0 0 0.75rem 0; font-size: 0.9rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em;">Payment Method</h4>
                        <p style="margin: 0; font-size: 0.95rem; font-weight: 600; color: var(--text-primary);">
                            <i class="fa-solid fa-credit-card" style="margin-right: 0.5rem;"></i> @Model.PaymentMethod
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
