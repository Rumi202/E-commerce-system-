@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>E-Commerce - The Future of Shopping</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
            background: #ffffff;
            color: #111827;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            position: relative;
        }

        /* Abstract glowing background blobs */
        .blob {
            position: absolute;
            filter: blur(100px);
            z-index: 0;
            opacity: 0.6;
        }
        .blob-1 { top: -10%; left: -10%; width: 500px; height: 500px; background: #8b5cf6; border-radius: 50%; }
        .blob-2 { bottom: -10%; right: -10%; width: 600px; height: 600px; background: #3b82f6; border-radius: 50%; }

        .splash-content {
            position: relative;
            z-index: 10;
            text-align: center;
            animation: fadeIn 1.5s ease-out forwards;
        }

        h1 {
            font-size: 5rem;
            font-weight: 800;
            margin: 0 0 1rem 0;
            letter-spacing: -2px;
            background: linear-gradient(to right, #3b82f6, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        p {
            font-size: 1.5rem;
            color: #64748b;
            margin-bottom: 3rem;
            font-weight: 300;
        }

        .enter-btn {
            display: inline-block;
            padding: 1.2rem 3rem;
            font-size: 1.25rem;
            font-weight: 600;
            color: white;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 50px;
            text-decoration: none;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }

        .enter-btn:hover {
            background: black;
            color: white;
            border-color: black;
            transform: translateY(-3px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }

        @("@")keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    
    <div class="splash-content">
        <h1>STOREFACE</h1>
        <p>Premium Commerce. Redefined.</p>
        <a href="/Home/Index" class="enter-btn">Enter Store</a>
    </div>
</body>
</html>
