@{
    ViewData["Title"] = "Verification Successful";
}

<div class="page-wrapper" style="display: flex; justify-content: center; align-items: center; min-height: 60vh; margin-top: 2rem;">
    <div style="background: white; padding: 3rem; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); width: 100%; max-width: 500px; text-align: center; border: 1px solid var(--border-color);">
        <div style="font-size: 4rem; color: #10b981; margin-bottom: 1.5rem;">
            <i class="fa-solid fa-circle-check"></i>
        </div>
        <h1 style="font-size: 2rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1rem;">Email Verified!</h1>
        <p style="color: var(--text-secondary); line-height: 1.6; margin-bottom: 2rem;">
            Your email has been successfully verified. You can now log in to your account and start shopping.
        </p>
        
        <a href="@Url.Action("Login", "Account")" style="display: inline-block; width: 100%; padding: 1rem; background: black; color: white; text-decoration: none; border-radius: var(--radius-md); font-weight: 700; transition: transform 0.2s;">
            Go to Login
        </a>
    </div>
</div>
